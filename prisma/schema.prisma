// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
// Fixed lists of allowed values, matching the TypeScript unions in types/.
// Postgres enforces these at the database level, not just at compile time.

enum TravelMode {
  PLANE
  BOAT
  CAR
  TRAIN
  BUS
  OTHER
}

enum LocalTravelMode {
  WALK
  TAXI
  TRANSIT
  RIDESHARE
  OTHER
}

enum BlockType {
  ACTIVITY
  MEAL
  VISIT
  REST
  TRAVEL
  BLANK
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum BudgetScopeKind {
  TRIP
  DAY
  BLOCK
}

// ---------- Models ----------

// Minimal placeholder until auth is wired up next. Just enough to make the
// User -> Trip relationship real.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  trips Trip[]
}

model Trip {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Place fields embedded directly (see: "embedding vs normalizing" decision)
  destinationName String
  destinationLat  Float?
  destinationLng  Float?

  departureDate DateTime
  departureTime String?
  arrivalDate   DateTime
  arrivalTime   String?
  returnDate    DateTime
  returnTime    String?

  totalBudget Decimal? @db.Decimal(12, 2)
  currency    String   @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelSegments   TravelSegment[]
  accommodations   Accommodation[]
  advanceBookings  AdvanceBooking[]
  itineraryDays    ItineraryDay[]
  budgetAllocations BudgetAllocation[]
}

model TravelSegment {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  mode         TravelMode
  providerName String?

  fromPlaceName String?
  fromPlaceLat  Float?
  fromPlaceLng  Float?
  toPlaceName   String?
  toPlaceLat    Float?
  toPlaceLng    Float?

  departureDate DateTime?
  departureTime String?
  arrivalDate   DateTime?
  arrivalTime   String?

  isLayover Boolean @default(false)
  cost      Decimal? @db.Decimal(12, 2)

  // Plane-only details — embedded as nullable columns since they only ever
  // apply when mode = PLANE (see below for the alternative we considered).
  flightInsurance   Boolean?
  mealsIncluded     String? // "true"/"false" or a free-text description
  luggageCount      Int?
  luggageWeightKg   Float?
}

model Accommodation {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  placeName String
  placeLat  Float?
  placeLng  Float?

  name    String
  checkIn DateTime
  checkInTime  String?
  checkOut     DateTime
  checkOutTime String?

  willTransferLater Boolean @default(false)
  cost              Decimal? @db.Decimal(12, 2)
  notes             String?
}

model AdvanceBooking {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  title String
  notes String?
  cost  Decimal? @db.Decimal(12, 2)
}

model ItineraryDay {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  label String
  date  DateTime?

  // Explicit ordering of days left-to-right, same pattern as ItineraryBlock.sortOrder.
  sortOrder Int @default(0)

  blocks           ItineraryBlock[]
  budgetAllocation BudgetAllocation?
}

model ItineraryBlock {
  id    String       @id @default(uuid())
  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  type        BlockType
  title       String
  description String?

  scheduledTime   String?
  plannedExpense  Decimal? @db.Decimal(12, 2)

  locationName String?
  locationLat  Float?
  locationLng  Float?

  mealType   MealType?
  travelMode LocalTravelMode?

  // Explicit ordering within a day — see explanation below.
  sortOrder Int @default(0)

  budgetAllocation BudgetAllocation?
}

model BudgetAllocation {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  label     String
  amount    Decimal @db.Decimal(12, 2)
  scopeKind BudgetScopeKind

  // Only one of these is set, depending on scopeKind (see BudgetScope decision above).
  // Both are @unique because each day/block can have at most one allocation
  // pointing at it (a 1-to-1 relation, not 1-to-many).
  dayId   String?         @unique
  day     ItineraryDay?   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  blockId String?         @unique
  block   ItineraryBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)
}
